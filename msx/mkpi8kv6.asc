1 PRINT"MKPI8K - 8K MSX1 Pi Spigot Builder":PRINT"Makes 8K version (PI8K+PI8K.B) from":PRINT"PIV13 using VRAM for digits (also":PRINT"runs on larger MSXes)."
2 PRINT:PRINT"Needs: 24K+ MSX (on 16K, first run":PRINT"DELETE 1990-2060), PIV13.BAS loaded,":PRINT"and THIS file saved in ASCII format:":PRINT"  Disk: SAVE"+CHR$(34)+"MKPI8K.BAS"+CHR$(34)+",A":PRINT"  Tape: SAVE"+CHR$(34)+"CAS:MKPI8K"+CHR$(34)
3 PRINT:PRINT"Tape order: CAS:PI8K.B is saved 1st,":PRINT"CAS:PI8K 2nd. On 8K: RUN"+CHR$(34)+"CAS:PI8K"+CHR$(34):PRINT"then rewind to PI8K.B when BLOAD":PRINT"waits (or use 2 tapes)."
4 PRINT:PRINT"Usage:":PRINT"  LOAD"+CHR$(34)+"PIV13.BAS"+CHR$(34)+" (or CAS:PIV13)":PRINT"  MERGE"+CHR$(34)+"MKPI8K.BAS"+CHR$(34)+" (or CAS:MKPI8K)":PRINT"  RUN 50"
9 STOP
50 H$="DELETE1840-1860"+CHR$(13)+"RUN51"+CHR$(13):GOTO 90
51 B!=PEEK(&HFC4A)+PEEK(&HFC4B)*256:IF PEEK(B!+1913)=165 AND PEEK(B!+1914)=90 THEN 53
52 CLEAR 200,B!-1916:DEFINT A-Z:B!=PEEK(&HFC4A)+PEEK(&HFC4B)*256:POKE B!+1913,165:POKE B!+1914,90:POKE B!+1915,48
53 DEFINT A-Z:D!=PEEK(&HFC4A)+PEEK(&HFC4B)*256:A!=0:RESTORE 1900:B!=D!+1782:GOSUB 1045:POKE D!+1915,48:PRINT"Decoded OK"
54 V=PEEK(&H2D):T=0:IF PEEK(&HFB21)>0 THEN IF V>=3 THEN T=1 ELSE GOSUB 80
55 IF T=1 THEN H$="DELETE73-76"+CHR$(13)+"RUN57"+CHR$(13):GOTO 90
56 H$="DELETE69-72"+CHR$(13)+"RUN57"+CHR$(13):GOTO 90
57 H$="DELETE999-999"+CHR$(13)+"RUN58"+CHR$(13):GOTO 90
58 H$="DELETE1035-1090"+CHR$(13)+"RUN59"+CHR$(13):GOTO 90
59 H$="DELETE1130-1195"+CHR$(13)+"RUN60"+CHR$(13):GOTO 90
60 H$="DELETE1215-1255"+CHR$(13)+"RUN61"+CHR$(13):GOTO 90
61 H$="DELETE1280"+CHR$(13)+"RUN63"+CHR$(13):GOTO 90
63 H$="DELETE1365-1392"+CHR$(13)+"RUN64"+CHR$(13):GOTO 90
64 H$="DELETE1400-1415"+CHR$(13)+"RUN65"+CHR$(13):GOTO 90
65 H$="DELETE1430-1435"+CHR$(13)+"RUN66"+CHR$(13):GOTO 90
66 H$="DELETE1900-2070"+CHR$(13)+"RUN68"+CHR$(13):GOTO 90
68 S!=PEEK(&HFC4A)+PEEK(&HFC4B)*256
69 H$="1008 S0!="+MID$(STR$(S!),2)+":F$="+CHR$(34)+"PI8K.B"+CHR$(34)+CHR$(13)+"RUN70"+CHR$(13):GOTO 90
70 S!=PEEK(&HFC4A)+PEEK(&HFC4B)*256:F$="PI8K.B":GOSUB 77:BSAVE"PI8K.B",S!,S!+1912:PRINT F$;" complete."
71 F$="PI8K.BAS":GOSUB 77
72 H$="DELETE1-90"+CHR$(13)+"SAVE"+CHR$(34)+"PI8K.BAS"+CHR$(34)+CHR$(13)+"?"+CHR$(34)+"Done!"+CHR$(34)+CHR$(13):GOTO 90
73 H$="1008 S0!="+MID$(STR$(S!),2)+":F$="+CHR$(34)+"CAS:PI8K.B"+CHR$(34)+CHR$(13)+"RUN74"+CHR$(13):GOTO 90
74 S!=PEEK(&HFC4A)+PEEK(&HFC4B)*256:F$="CAS:PI8K.B":GOSUB 77:BSAVE"CAS:PI8K.B",S!,S!+1912:PRINT F$;" complete. STOP tape!"
75 F$="CAS:PI8K":GOSUB 77
76 H$="DELETE1-90"+CHR$(13)+"SAVE"+CHR$(34)+"CAS:PI8K"+CHR$(34)+CHR$(13)+"?"+CHR$(34)+"Stop tape"+CHR$(34)+CHR$(13):GOTO 90
77 PRINT"Next file: ";F$:IF LEFT$(F$,4)="CAS:" THEN PRINT"Prepare tape, press REC+PLAY," ELSE PRINT"Prepare disk,"
78 PRINT"press any key to write.":GOSUB 85:PRINT"Writing ";F$;"...":RETURN
80 INPUT"Write to (T)ape or (D)isk";H$:T=-(H$="D" OR H$="d"):IF T=0 AND H$<>"T" AND H$<>"t" THEN 80
81 RETURN
85 IF INKEY$<>"" THEN 85
86 IF INKEY$="" THEN 86
87 RETURN
90 POKE &HF3F8,&HF0:POKE &HF3F9,&HFB:POKE &HF3FA,&HF0:POKE &HF3FB,&HFB:FOR J=1 TO LEN(H$):POKE &HFBEF+J,ASC(MID$(H$,J,1)):NEXT:T0=240+LEN(H$):POKE &HF3F8,T0 AND 255:POKE &HF3F9,&HFB-(T0>=256):END
1000 DEFINT A-Z:A!=PEEK(&HFC4A)+PEEK(&HFC4B)*256:IF PEEK(A!+1913)=165AND PEEK(A!+1914)=90THEN CLEAR 30:DEFINT A-Z:A!=PEEK(&HFC4A)+PEEK(&HFC4B)*256:GOTO1005
1002 CLEAR 30,A!-1916:DEFINT A-Z:A!=PEEK(&HFC4A)+PEEK(&HFC4B)*256:POKE A!+1913,165:POKE A!+1914,90:POKE A!+1915,48
1005 H#=59.922751013551#:V=PEEK(&H2D):IF FRE(0)<150THEN PRINT"OOM":END
1008 S0!=0:F$=""
1010 IF FRE(0)>1600THEN M=INT((FRE(0)-500)/2)-1:DIM M%(M)
1015 TIME=0:IF V=0THEN T0=PEEK(&H2B)AND128 ELSE T0=VDP(10)AND2
1020 IF T0 THEN H#=50.158979521123#
1025 IF PEEK(A!+1915)=56THEN1110
1030 PRINT"Load ";F$;:D!=A!-S0!:D!=D!-(D!<0)*65536!:BLOAD F$,D!
1032 B!=A!+1782:C!=A!-1:GOSUB1095:POKE A!+1915,56:GOTO1110
1110 E!=TIME/H#:T0=PEEK(&HFC49):K=32+(T0=&HC0)*16+(T0=&HA0)*8+(T0=&HE0)*24:J!=A!+1610:K!=A!+1085
1120 IF M=0THEN B!=A!+1610:B=151:W=40:T=1392 ELSE B=M+1:W=INT(B/14)*4:IF W>2432THEN W=2432
1125 IF M>0THEN T=INT((B+4734)/14)*4:IF T>2432THEN T=2432
1202 DEFUSR=A!+1755:T0=USR(0):I!=(T0-(T0<0)*65536!)*320*H#/1E6
1210 C!=65535!:IF C>W THEN C!=B
1275 D!=A!+3:GOSUB1395:B!=B:GOSUB1395:B!=C!:GOSUB1395:B!=A!:GOSUB1395:B!=C:GOSUB1395:POKE A!+15,0:TIME=0:T4=-(C!<65535!AND-INT(-C/4)*14!>B+1662)*4:COLOR6,15,15:SCREEN2:CLS
1290 DEFUSR=J!:T1=USR(T4):F!=TIME/H#:D=INT(-C/4):D#=0:E#=0:W=0:G!=0:S=0:IF M=0THEN POKE A!+1915,48 ELSE B!=VARPTR(M%(0)):B!=B!-(B!<0)*65536!:D!=A!+3:GOSUB1395
1293 DEFUSR=A!:T1=USR(D):D=-D:ON STOP GOSUB1345:STOP ON:TIME=0
1295 B!=TIME:DEFUSR=A!:T1=USR(D):G!=TIME:D#=D#+G!-B!:DEFUSR=K!:T0=USR(T1):B!=TIME:E#=E#+B!-G!:IF B!>28000THEN TIME=0
1325 STOP OFF
1360 PRINT"Work: RAM";LEFT$("+VRAM",-(C!<65535!)*5):RETURN
1420 PRINT"pi approximator 8k+":PRINT"MSX";MID$("  2 2+turboR",1+V*2,1-(V=2)-(V=3)*5);LEFT$(" +DiskROM",-(PEEK(&HFB21)>0)*9);LEFT$(" ",-(I!>=10));:PRINT USING"##.##MHz ";I!;:PRINT"CPU"
1425 PRINT USING"##.##Hz ";H#;:PRINT"VDP":PRINT"RAM:";K;"K":PRINT USING"Load: ####.##s";E!:RETURN
